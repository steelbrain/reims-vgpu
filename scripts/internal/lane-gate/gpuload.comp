#version 450
// gpuload's dispatch (gpuload.c): ITERS dependent FMAs a thread, the result stored so the loop stays.
layout(local_size_x = 256) in;
layout(push_constant) uniform Push { uint iters; } p;
layout(std430, binding = 0) buffer Out { float v[]; } o;

void main()
{
	uint i = gl_GlobalInvocationID.x;
	float x = float(i) * 1e-6, y = 1.0;
	for (uint k = 0u; k < p.iters; k++) {
		x = fma(x, 1.000001, 0.5);
		y = fma(y, x, -0.25);
	}
	o.v[i & 1023u] = x + y;
}
