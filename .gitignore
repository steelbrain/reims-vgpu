# Build output: QEMU's builds, the coverage build and the VM clones.
/build/

# The option ROM's build, when make runs in firmware/ (cargo xtask dist builds
# it under the target directory), and the Ambrosia module's.
/firmware/build/
/firmware/ambrosia/build/

# The guest display kext's build.
/guest/kext/build/

# Python's bytecode caches.
__pycache__/

# Editor / OS
.DS_Store

# The Cargo workspace's build trees (target, and any target-* beside it), and
# reims-ctl's, which is a workspace of its own.
/target*/
/crates/reims-ctl/target/
